# Optional controlled collection runtime. No extra Linux capabilities required.
FROM localhost/security-rl-desktop-api:dev
USER root
RUN apt-get update && apt-get install -y --no-install-recommends nmap \
    && rm -rf /var/lib/apt/lists/*
COPY src/rlredteam /app/src/rlredteam
ENV PYTHONPATH=/app/src
USER 10001:10001
CMD ["uvicorn", "rlredteam.api.workspace_runtime:create_configured_app", "--factory", "--host", "127.0.0.1"]
