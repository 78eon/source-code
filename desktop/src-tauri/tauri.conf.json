{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Security-RL Analyst",
  "version": "0.1.0",
  "identifier": "org.securityrl.analyst",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Security-RL Analyst",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:8765; style-src 'self' 'unsafe-inline'; img-src 'self' data:; object-src 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": false
  }
}
