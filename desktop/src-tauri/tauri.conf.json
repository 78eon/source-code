{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Security-RL Analyst",
  "version": "0.1.0",
  "identifier": "org.securityrl.analyst",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Security-RL Analyst",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:*; style-src 'self' 'unsafe-inline'; img-src 'self' data:; object-src 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "category": "DeveloperTool",
    "shortDescription": "Read-only Security-RL analyst desktop",
    "longDescription": "Native analyst workspace for explicitly selected recorded evidence. PostgreSQL and Neo4j remain external services. Includes the local Python/FastAPI runtime.",
    "resources": {"runtime/security-rl-api/": "runtime/security-rl-api/"},
    "linux": {"deb": {"depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0", "libayatana-appindicator3-1"], "recommends": ["gnome-keyring"]}}
  }
}
